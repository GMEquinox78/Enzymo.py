    def calculate_velocity(params, conc):
        """Michaelis-Menten kinetics calculation"""
        try:
            return (params['Vmax'] * conc) / (params['Km'] + conc)
        except ZeroDivisionError:
            return 0.0

    def get_inputs():
        """Interactive input handling with validation"""
        print("\nAvailable Enzymes:", ", ".join(BIOCHEM_DB['enzymes'].keys()))
        enzyme = input("Enter enzyme name: ").lower()
        if enzyme not in BIOCHEM_DB['enzymes']:
            print("Invalid enzyme selection!")
            return None
            
        data = BIOCHEM_DB['enzymes'][enzyme]
        
        print("\nGenetic Variants:", ", ".join(data['variants'].keys()))
        variant = input("Enter variant (or 'none'): ").lower()
        
        print("Associated Comorbidities:", ", ".join(data['comorbidities'].keys()))
        comorbidity = input("Enter comorbidity (or 'none'): ").lower()
        
        try:
            conc = float(input("Substrate concentration (mM): "))
        except ValueError:
            print("Invalid concentration value!")
            return None
            
        return enzyme, variant, comorbidity, conc

    def apply_effects(params, enzyme, variant, comorbidity):
        """Apply genetic and comorbidity effects to Vmax"""
        adjusted = params.copy()
        
        # Apply genetic variant
        if variant in BIOCHEM_DB['enzymes'][enzyme]['variants']:
            factor = BIOCHEM_DB['enzymes'][enzyme]['variants'][variant]
            adjusted['Vmax'] *= factor
            print(f"Applied {variant} variant: {factor*100}% activity")
            
        # Apply comorbidity
        if comorbidity in BIOCHEM_DB['enzymes'][enzyme]['comorbidities']:
            factor = BIOCHEM_DB['enzymes'][enzyme]['comorbidities'][comorbidity]
            adjusted['Vmax'] *= factor
            print(f"Applied {comorbidity}: {factor*100}% activity")
            
        return adjusted

    # Main program
    print("="*60)
    print("Comprehensive Enzyme Interaction Analyzer")
    print("="*60)
    print("Integrated Disease & Genetic Variant Effects\n")
    
    while True:
        inputs = get_inputs()
        if not inputs:
            if input("Retry? (y/n): ").lower() != 'y': break
            continue
            
        enzyme, variant, comorbidity, conc = inputs
        params = BIOCHEM_DB['enzymes'][enzyme]['params'].copy()
        
        # Apply modifications
        mod_params = apply_effects(params, enzyme, variant, comorbidity)
        velocity = calculate_velocity(mod_params, conc)
        
        # Display results
        print("\nResults:")
        print(f"Adjusted Vmax: {mod_params['Vmax']:.1f} μmol/min/mg")
        print(f"Catalytic Efficiency: {mod_params['Vmax']/mod_params['Km']:.1f} min⁻¹/mM")
        print(f"Reaction Velocity: {velocity:.2f} μmol/min/mg")
        
        # Clinical warnings
        low, high = mod_params['clinical_range']
        if conc < low:
            print(f"\n! Subtherapeutic: Minimum {low} mM required !")
        elif conc > high:
            print(f"\n! Toxicity Risk: Maximum safe {high} mM !")
            
        if input("\nNew analysis? (y/n): ").lower() != 'y': break

    print("\nAnalysis complete. Consult clinical guidelines for interpretation.")

